# ReviewIQ AI Environment Configuration Example

# Backend Settings
PROJECT_NAME="ReviewIQ AI"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite Database (default)
DATABASE_URL="sqlite:///./backend/reviewiq.db"

# Optional PostgreSQL Connection (if using Postgres instead of SQLite)
# DATABASE_URL="postgresql://user:password@localhost:5432/reviewiq"

# Frontend API URL (if custom)
VITE_API_URL="http://127.0.0.1:8000/api"
